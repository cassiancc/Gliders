{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "basic",
        "model": {
          "type": "minecraft:model",
          "model": "vc_gliders:item/paraglider_wood"
        }
      },
      {
        "when": "combined",
        "model": {
          "type": "minecraft:model",
          "model": "vc_gliders:item/paraglider_wood_combined_upgrades"
        }
      },
      {
        "when": "copper",
        "model": {
          "type": "minecraft:model",
          "model": "vc_gliders:item/paraglider_wood_copper_upgrade"
        }
      },
      {
        "when": "nether",
        "model": {
          "type": "minecraft:model",
          "model": "vc_gliders:item/paraglider_wood_nether_upgrade"
        }
      },
      {
        "when": "damaged",
        "model": {
          "type": "minecraft:model",
          "model": "vc_gliders:item/damaged_glider"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "vc_gliders:item/paraglider_wood"
    }
  }
}